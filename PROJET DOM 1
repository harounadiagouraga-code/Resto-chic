// Sélection des éléments
const plusBtns = document.querySelectorAll(".fa-plus-circle");
const minusBtns = document.querySelectorAll(".fa-minus-circle");
const deleteBtns = document.querySelectorAll(".fa-trash-alt");
const heartBtns = document.querySelectorAll(".fa-heart");

// Fonction de calcul du total
function updateTotal() {
  let total = 0;

  const cards = document.querySelectorAll(".card-body");

  cards.forEach(card => {
    const quantity = parseInt(
      card.querySelector(".quantity").textContent
    );

    const price = parseInt(
      card.querySelector(".unit-price").textContent
    );

    total += quantity * price;
  });

  document.querySelector(".total").textContent = total + " $";
}

// Boutons +
plusBtns.forEach(btn => {
  btn.addEventListener("click", () => {
    let quantityElement =
      btn.parentElement.querySelector(".quantity");

    quantityElement.textContent =
      parseInt(quantityElement.textContent) + 1;

    updateTotal();
  });
});

// Boutons -
minusBtns.forEach(btn => {
  btn.addEventListener("click", () => {
    let quantityElement =
      btn.parentElement.querySelector(".quantity");

    let quantity = parseInt(quantityElement.textContent);

    if (quantity > 0) {
      quantityElement.textContent = quantity - 1;
    }

    updateTotal();
  });
});

// Suppression d'un article
deleteBtns.forEach(btn => {
  btn.addEventListener("click", () => {
    btn.closest(".card-body").remove();

    updateTotal();
  });
});

// Like (cœur)
heartBtns.forEach(btn => {
  btn.addEventListener("click", () => {
    btn.classList.toggle("liked");
  });
});

// Calcul initial
updateTotal();
